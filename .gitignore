# ============================================================
# Environment / secrets -- never commit real credentials
# ============================================================
.env
.env.*
!.env.example

# ============================================================
# Python
# ============================================================
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
env/
ENV/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ============================================================
# Node / frontend build tooling (none in use today, kept for hygiene)
# ============================================================
node_modules/
dist/
build/
.cache/
.vite/

# Deploy-time generated frontend config (see frontend/env.example.js) --
# holds this deployment's own API URL, regenerated per environment.
frontend/env.js

# ============================================================
# Local databases / caches -- regenerated, not source
# ============================================================
*.db
*.sqlite
*.sqlite3
data/processed/

# The 75k-row historical opportunity dataset: a large, downloaded/curated
# data file, not source code. Kept out of version control to keep the
# repository lightweight -- see README.md's "Data" note for how to obtain
# or supply your own copy at this same path.
data/raw/

# Local evaluation-run output (regenerated by src/evaluation/run_eval.py);
# data/evaluation/ngo_profiles.json is a small synthetic fixture and stays.
data/evaluation/candidates.csv
data/evaluation/labels.csv

# ============================================================
# Logs / temp
# ============================================================
*.log
logs/
tmp/
temp/

# ============================================================
# OS / editor
# ============================================================
.DS_Store
Thumbs.db
.vscode/
.idea/

# ============================================================
# Project-specific: local-only, never for version control
# ============================================================
# Claude Code session-internal files, not part of the application
.claude/

# Stray empty local artifact, not application data
/your_database.db

# Scratch/local-only script -- excluded because it has previously
# contained a hardcoded API key; never meant to ship with the app
/Untitled-1.py

# Generated deployment PDF -- a build artifact, not source
/GrantSetu_Deployment_Guide.pdf
