# ============================================================
# DATABASE
# ============================================================

# SQLite for local development
DATABASE_URL=sqlite:///data/processed/grantsetu.db

# PostgreSQL example for production deployment (AWS RDS or a low-cost
# platform's managed Postgres add-on both use this same shape -- requires
# psycopg2-binary, already in requirements.txt):
# DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/grantsetu


# ============================================================
# NETWORK / DEPLOYMENT
# ============================================================

# development | production. production turns on startup config checks
# (api/main.py::_check_production_config) that refuse to boot with an
# empty CORS_ORIGINS or a placeholder GRANTSETU_ENCRYPTION_KEY.
ENVIRONMENT=development
DEBUG=true

# Comma-separated list of browser origins allowed to call this API. NEVER
# "*" in production. Example for a real deployment:
# CORS_ORIGINS=https://app.grantsetu.example,https://grantsetu.example
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Port the backend listens on. Railway/Render set this automatically;
# AWS/docker-compose use the default.
PORT=8000

# gunicorn worker count (Dockerfile's CMD). Keep this at 1 if
# ENABLE_SCHEDULER=true below (see api/scheduler.py).
WEB_CONCURRENCY=2

# Shared secret required (via the X-Admin-Token header) for operator-only
# endpoints: POST /admin/grant-sources, POST /admin/sync-source/{id},
# POST /admin/refresh-index. Leave unset for local development. REQUIRED
# in production -- api/main.py logs a startup warning if it's missing.
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_TOKEN=

# Runs source refresh on an in-process timer (api/scheduler.py) -- an
# alternative to platform-native scheduling (AWS EventBridge, Render/
# Railway Cron Jobs) calling POST /admin/sync-all-sources directly. Leave
# false if you're using platform-native scheduling, or if you run more than
# one backend instance/worker (multiple schedulers would double-sync).
ENABLE_SCHEDULER=false
SYNC_INTERVAL_HOURS=6

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Backend URL the STATIC FRONTEND is built to call (frontend/env.js,
# rendered from frontend/env.example.js by scripts/render_frontend_env.sh
# or the frontend Docker image's entrypoint). Not read by the backend itself.
# API_BASE_URL=https://api.grantsetu.example


# ============================================================
# EMAIL CONFIGURATION
# ============================================================

# Options: mock, brevo, resend
# "mock" (default) logs emails instead of sending them -- safe for local
# development, never claims a real delivery. Use "brevo" to send real email.
EMAIL_PROVIDER=mock

# Brevo API key -- required only if EMAIL_PROVIDER=brevo. Get it from:
# Brevo Dashboard → Settings → SMTP & API → API Keys
# NEVER commit a real key here -- put it in your local, gitignored .env file.
BREVO_API_KEY=

# Verified sender details -- required only if EMAIL_PROVIDER=brevo. Brevo
# will refuse to send until the sender address/domain is verified in your
# Brevo dashboard.
EMAIL_FROM_NAME=GrantSetu
EMAIL_FROM_ADDRESS=
EMAIL_REPLY_TO=

# Required only when using Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Email verification is always required by the current implementation
EMAIL_VERIFICATION_REQUIRED=true


# ============================================================
# APPLICATION URLS
# ============================================================

# The frontend's own URL -- used for the Google-sign-in redirect
# (api/routers/auth.py) and links inside notification emails
# (src/email/templates.py, which also honors FRONTEND_BASE_URL if you'd
# rather set that specifically -- FRONTEND_URL is the one variable you need
# in the normal case where both point at the same place).
FRONTEND_URL=http://localhost:5500


# ============================================================
# GRANT DISCOVERY SOURCES
# ============================================================

# Grants.gov public API does not require an API key
GRANTS_GOV_API_KEY=

# Enable Grants.gov discovery
GRANTS_GOV_ENABLED=true

# Search provider options: none, brave, searxng
SEARCH_PROVIDER=brave

# Brave Search API key
# Get it from:
# https://brave.com/search/api/
BRAVE_SEARCH_API_KEY=YOUR_BRAVE_SEARCH_API_KEY_HERE

# Optional self-hosted SearXNG endpoint
SEARXNG_BASE_URL=


# ============================================================
# AI CONFIGURATION
# ============================================================

# AI is configured individually by each NGO through the application.
# No global AI key is required.
AI_PROVIDER=none

# Optional global provider keys, if required by future features
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
TOGETHER_API_KEY=
OPENROUTER_API_KEY=
COHERE_API_KEY=


# ============================================================
# ENCRYPTION
# ============================================================

# Used to encrypt NGO-specific AI API keys in the database.
# Generate one using:
# python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GRANTSETU_ENCRYPTION_KEY=YOUR_FERNET_ENCRYPTION_KEY_HERE


# ============================================================
# GOOGLE SIGN-IN (optional -- guest usage always fully works without this)
# ============================================================

# All three required together for the "Sign in with Google" button to
# appear (GET /auth/config reports google_enabled based on this). Get a
# client ID/secret from https://console.cloud.google.com/apis/credentials
# (OAuth client type: Web application). GOOGLE_REDIRECT_URI must exactly
# match one of the "Authorized redirect URIs" configured there, and must
# point at THIS backend's /auth/google/callback route (not the frontend).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback


